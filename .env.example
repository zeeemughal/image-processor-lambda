# --- Required ---
# How the processing result reaches the backend: 'api' (direct HTTP, default)
# or 'sqs' (publish to SQS_QUEUE_URL — backend consumes)
NOTIFY_MODE=api
# Base URL of the image-service-backend (required for NOTIFY_MODE=api;
# must be reachable from the Lambda)
BACKEND_URL=http://localhost:3001
# Shared secret — must match the backend's LAMBDA_API_KEY (api mode)
LAMBDA_API_KEY=change-me-too
# Queue URL for processor events (required for NOTIFY_MODE=sqs)
# SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/image-service-events

# --- Optional ---
# Bucket to write compressed images to (defaults to the source bucket)
# TARGET_BUCKET=my-image-bucket
# Max image width in px (default 2000)
# MAX_WIDTH=2000
# JPEG quality 1-100 (default 80)
# JPEG_QUALITY=80

# AWS credentials: resolved by the SDK default chain (Lambda execution role).
# For local testing only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
