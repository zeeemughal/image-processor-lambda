# --- Required ---
# Base URL of the image-service-backend (must be reachable from the Lambda)
BACKEND_URL=http://localhost:3001
# Shared secret — must match the backend's LAMBDA_API_KEY
LAMBDA_API_KEY=change-me-too

# --- Optional ---
# Bucket to write compressed images to (defaults to the source bucket)
# TARGET_BUCKET=my-image-bucket
# Max image width in px (default 2000)
# MAX_WIDTH=2000
# JPEG quality 1-100 (default 80)
# JPEG_QUALITY=80

# AWS credentials: resolved by the SDK default chain (Lambda execution role).
# For local testing only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
